# SignalRank AI — Environment Configuration
# Copy this file to .env and fill in values for your deployment.
# Never commit .env to version control.

# ── Output & data paths ───────────────────────────────────────────────────────
# Directory where pipeline results are written (default: ./outputs)
# In production, point this to a persistent volume mount.
SIGNALRANK_OUTPUTS=outputs

# Path to the pre-computed candidate dataset (default: data/raw/candidates.jsonl)
# In production, point this to a mounted volume or object storage path.
SIGNALRANK_CANDIDATES=data/raw/candidates.jsonl

# ── Streamlit server ──────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
